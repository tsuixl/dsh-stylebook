{
  "name": "dsh-stylebook",
  "version": "0.1.0-beta.1",
  "description": "Typography, three-color themes and named appearance presets for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "tsuixl",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsuixl/dsh-stylebook.git"
  },
  "homepage": "https://github.com/tsuixl/dsh-stylebook#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "appearance",
    "font",
    "theme"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.5"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
